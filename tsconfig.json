{
  "compilerOptions": {
    "target": "ES2024",
    "module": "node20",
    "lib": ["ES2024"],
    "types": ["node"],
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    // Tests run as .ts straight through Node's type stripping: imports name the real .ts file,
    // and only syntax Node can erase (no enums, namespaces, parameter properties) is allowed.
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    // eslint.config.js stays JS: ESLint loads a .ts config only through the jiti package or an
    // unstable flag that editor integrations don't pass. checkJs still type-checks it; it is
    // the only .js file included.
    "allowJs": true,
    "checkJs": true
  },
  "include": ["src/**/*", "scripts/**/*", "tsup.config.ts", "eslint.config.js"]
}
